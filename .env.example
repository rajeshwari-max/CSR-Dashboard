# ---------------------------------------------------------------------------
# Optional: AI narration + "chat with the dashboard".
# Everything on the AI Insights page is computed deterministically from the
# dataset and works with these unset. A key only adds narration and free-text Q&A.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5       # e.g. gpt-4o-mini for openai

# Optional. Only needed if you deploy the API separately from the UI.
NEXT_PUBLIC_API_BASE_URL=
