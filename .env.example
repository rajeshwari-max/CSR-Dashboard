# Optional dashboard login. When set, every page and API route requires the
# first-party login window; the browser receives a secure 12-hour session cookie.
# Set the real value only in the deployment environment, never in this file.
APP_PASSWORD=

# Optional separate directory for users.json. By default registered accounts
# use CSR_DATA_DIR, so they persist on the same mounted production disk.
AUTH_DATA_DIR=

# Secure email OTP and administrator approval notifications. Create these in
# the deployment environment; never commit real keys or passwords.
RESEND_API_KEY=
OTP_FROM_EMAIL=CMS CSR Intelligence <access@your-verified-domain.example>
ADMIN_EMAIL=

# Sign-in second factor. "required" (default) emails a six-digit code at every
# user sign-in; "off" lets approved users sign in with email + password only.
AUTH_EMAIL_OTP=required

# Public dashboard URL used for links in emails. On Render this defaults to the
# automatic RENDER_EXTERNAL_URL; set it only for a custom domain.
APP_BASE_URL=

# ---------------------------------------------------------------------------
# Optional: AI narration + "chat with the dashboard".
# Everything on the AI Insights page is computed deterministically from the
# dataset and works with these unset. A key only adds narration and broader
# free-text Q&A beyond the built-in verified question patterns.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5       # e.g. gpt-4o-mini for openai

# Optional. Only needed if you deploy the API separately from the UI.
NEXT_PUBLIC_API_BASE_URL=
